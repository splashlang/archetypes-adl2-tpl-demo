	<ikm:thing.dp.kguri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://bki.skane.se/ikm/id/ikmopenehr:termdefinition/splash-adl2-tpl/openEHR-DEMOGRAPHIC-ADDRESS.address.v1.0.0/terminology/main/en/at467</ikm:thing.dp.kguri>
