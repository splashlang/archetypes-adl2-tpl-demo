<rdf:Description rdf:about="http://bki.skane.se/ikm/id/ikmopenehr:modeldescription/splash-adl2-tpl/openEHR-EHR-EVALUATION.alert.v1.0.0/description/en">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdf:type rdf:resource="http://bki.skane.se/ikm/ont/ikmopenehr:modeldescription"/>
	<rdfs:label xml:lang="en">Alert</rdfs:label>
	<ikm:thing.dp.kgdisplay>Alert</ikm:thing.dp.kgdisplay>
	<ikm:thing.dp.kguri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://bki.skane.se/ikm/id/ikmopenehr:modeldescription/splash-adl2-tpl/openEHR-EHR-EVALUATION.alert.v1.0.0/description/en</ikm:thing.dp.kguri>
	<ehr:openehrobject.op.module rdf:resource="http://bki.skane.se/ikm/id/kg__module/openehr-draft-example"/>
	<ehr:modelelement.op.owner rdf:resource="http://bki.skane.se/ikm/id/ikmopenehr:archetype/splash-adl2-tpl/openEHR-EHR-EVALUATION.alert.v1.0.0"/>
	<ehr:modeldescription.dp.language>en</ehr:modeldescription.dp.language>
	<ehr:modeldescription.dp.name>Alert</ehr:modeldescription.dp.name>
	<ehr:modeldescription.dp.description>Information pertaining to a subject of care that may need special consideration by a healthcare provider before making a decision about his/her actions in order to avert an unfavourable healthcare event, or relate to the safety of subject or providers, or pertain to special circumstances relevant to the delivery of care</ehr:modeldescription.dp.description>
	<ehr:modeldescription.dp.purpose>For recording alerts of any kind in the health record</ehr:modeldescription.dp.purpose>
	<ehr:modeldescription.dp.use>test use</ehr:modeldescription.dp.use>
	<ehr:modeldescription.dp.keywords>nota bene</ehr:modeldescription.dp.keywords>
	<ehr:modeldescription.dp.keywords>warning</ehr:modeldescription.dp.keywords>
</rdf:Description>

