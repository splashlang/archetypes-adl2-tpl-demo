	<ikm:thing.dp.kgdisplay>Intersex or indeterminate</ikm:thing.dp.kgdisplay>
	<ikm:thing.dp.kguri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://bki.skane.se/ikm/id/ikmopenehr:termdefinition/splash-adl2-tpl/openEHR-DEMOGRAPHIC-CLUSTER.person_additional_data_iso.v1.0.0/terminology/main/en/at13</ikm:thing.dp.kguri>
