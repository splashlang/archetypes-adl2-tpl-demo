	<ehr:termdefinition.dp.code>id7</ehr:termdefinition.dp.code>
	<ehr:termdefinition.dp.language>en</ehr:termdefinition.dp.language>
	<ehr:termdefinition.dp.text>State/territory/province identifier</ehr:termdefinition.dp.text>
	<ehr:termdefinition.dp.description>An identifier of the province, state or territory containing the address.</ehr:termdefinition.dp.description>
</rdf:Description>

<rdf:Description rdf:about="http://bki.skane.se/ikm/id/ikmopenehr:termdefinition/splash-adl2-tpl/openEHR-DEMOGRAPHIC-ADDRESS.address.v1.0.0/terminology/main/en/id8">
