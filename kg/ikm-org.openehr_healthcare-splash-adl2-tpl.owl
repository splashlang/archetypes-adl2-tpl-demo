	<ehr:modelelement.op.owner rdf:resource="http://bki.skane.se/ikm/id/ikmopenehr:archetype/splash-adl2-tpl/openEHR-DEMOGRAPHIC-CLUSTER.person_additional_data_iso.v1.0.0"/>
