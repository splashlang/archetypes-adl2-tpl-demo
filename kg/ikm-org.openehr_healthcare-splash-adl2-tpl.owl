	<ehr:termdefinition.dp.code>id11</ehr:termdefinition.dp.code>
	<ehr:termdefinition.dp.language>en</ehr:termdefinition.dp.language>
	<ehr:termdefinition.dp.text>Local high level address components</ehr:termdefinition.dp.text>
	<ehr:termdefinition.dp.description>Local high level address components. Archetypes that include other elements not present in ISO/TS22220 to meet local needs like county/parish, etc.</ehr:termdefinition.dp.description>
</rdf:Description>

