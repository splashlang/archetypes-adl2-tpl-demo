	<ehr:termdefinition.dp.text>No fixed address</ehr:termdefinition.dp.text>
	<ehr:termdefinition.dp.description>Used where a person has no fixed address.</ehr:termdefinition.dp.description>
</rdf:Description>

<rdf:Description rdf:about="http://bki.skane.se/ikm/id/ikmopenehr:termdefinition/splash-adl2-tpl/openEHR-DEMOGRAPHIC-ADDRESS.address.v1.0.0/terminology/main/en/at467">
