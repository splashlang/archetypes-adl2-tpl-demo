	<ehr:termdefinition.dp.text>Street name</ehr:termdefinition.dp.text>
	<ehr:termdefinition.dp.description>The name that identifies a public thoroughfare and differentiates it from others in the same suburb/town/locality.</ehr:termdefinition.dp.description>
</rdf:Description>

<rdf:Description rdf:about="http://bki.skane.se/ikm/id/ikmopenehr:termdefinition/splash-adl2-tpl/openEHR-DEMOGRAPHIC-ADDRESS.address.v1.0.0/terminology/main/en/id3">
