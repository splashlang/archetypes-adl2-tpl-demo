	<ehr:termdefinition.dp.text>Severe</ehr:termdefinition.dp.text>
	<ehr:termdefinition.dp.description>The severity of the index problem has had a major effect on life and/or longevity.</ehr:termdefinition.dp.description>
</rdf:Description>

<rdf:Description rdf:about="http://bki.skane.se/ikm/id/ikmopenehr:termdefinition/splash-adl2-tpl/openEHR-EHR-EVALUATION.problem.v1.0.0/terminology/main/en/id1">
