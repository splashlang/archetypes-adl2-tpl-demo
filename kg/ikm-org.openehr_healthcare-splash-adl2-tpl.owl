<rdf:Description rdf:about="http://bki.skane.se/ikm/id/ikmopenehr:modeldescription/splash-adl2-tpl/openEHR-DEMOGRAPHIC-CLUSTER.person_additional_data_iso.v1.0.0/description/en">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdf:type rdf:resource="http://bki.skane.se/ikm/ont/ikmopenehr:modeldescription"/>
	<rdfs:label xml:lang="en">Person additional demographic data</rdfs:label>
	<ikm:thing.dp.kgdisplay>Person additional demographic data</ikm:thing.dp.kgdisplay>
	<ikm:thing.dp.kguri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://bki.skane.se/ikm/id/ikmopenehr:modeldescription/splash-adl2-tpl/openEHR-DEMOGRAPHIC-CLUSTER.person_additional_data_iso.v1.0.0/description/en</ikm:thing.dp.kguri>
	<ehr:openehrobject.op.module rdf:resource="http://bki.skane.se/ikm/id/kg__module/openehr-draft-example"/>
	<ehr:modelelement.op.owner rdf:resource="http://bki.skane.se/ikm/id/ikmopenehr:archetype/splash-adl2-tpl/openEHR-DEMOGRAPHIC-CLUSTER.person_additional_data_iso.v1.0.0"/>
	<ehr:modeldescription.dp.language>en</ehr:modeldescription.dp.language>
	<ehr:modeldescription.dp.name>Person additional demographic data</ehr:modeldescription.dp.name>
	<ehr:modeldescription.dp.description>Person additional demographic data according to ISO 22220: sex and mother's family name</ehr:modeldescription.dp.description>
	<ehr:modeldescription.dp.purpose>Representation of a person's additional demographic data,based on ISO standards.</ehr:modeldescription.dp.purpose>
	<ehr:modeldescription.dp.use>Used in demographic service to collect a person's additional demographic data</ehr:modeldescription.dp.use>
	<ehr:modeldescription.dp.keywords>demographic service</ehr:modeldescription.dp.keywords>
	<ehr:modeldescription.dp.keywords>person's demographic data</ehr:modeldescription.dp.keywords>
