<rdf:Description rdf:about="http://bki.skane.se/ikm/id/ikmopenehr:modeldescription/splash-adl2-tpl/openEHR-DEMOGRAPHIC-ADDRESS.address.v1.0.0/description/en">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
	<rdf:type rdf:resource="http://bki.skane.se/ikm/ont/ikmopenehr:modeldescription"/>
	<rdfs:label xml:lang="en">Address</rdfs:label>
	<ikm:thing.dp.kgdisplay>Address</ikm:thing.dp.kgdisplay>
	<ikm:thing.dp.kguri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://bki.skane.se/ikm/id/ikmopenehr:modeldescription/splash-adl2-tpl/openEHR-DEMOGRAPHIC-ADDRESS.address.v1.0.0/description/en</ikm:thing.dp.kguri>
	<ehr:openehrobject.op.module rdf:resource="http://bki.skane.se/ikm/id/kg__module/openehr-draft-example"/>
	<ehr:modelelement.op.owner rdf:resource="http://bki.skane.se/ikm/id/ikmopenehr:archetype/splash-adl2-tpl/openEHR-DEMOGRAPHIC-ADDRESS.address.v1.0.0"/>
	<ehr:modeldescription.dp.language>en</ehr:modeldescription.dp.language>
	<ehr:modeldescription.dp.name>Address</ehr:modeldescription.dp.name>
	<ehr:modeldescription.dp.description>Address based on ISO22220 standard.</ehr:modeldescription.dp.description>
	<ehr:modeldescription.dp.purpose>Representation of data about a personal/organizational address, based on ISO 22220 standard.</ehr:modeldescription.dp.purpose>
	<ehr:modeldescription.dp.use>used to communicate with, identify service provision demograph requirements and trends, and to provide direct services.</ehr:modeldescription.dp.use>
	<ehr:modeldescription.dp.keywords>demographic service</ehr:modeldescription.dp.keywords>
	<ehr:modeldescription.dp.keywords>address</ehr:modeldescription.dp.keywords>
</rdf:Description>

