	<ehr:termdefinition.dp.code>at467</ehr:termdefinition.dp.code>
	<ehr:termdefinition.dp.language>en</ehr:termdefinition.dp.language>
	<ehr:termdefinition.dp.text>Unknown/not stated/inadequately described</ehr:termdefinition.dp.text>
	<ehr:termdefinition.dp.description>Unknown/not stated/inadequately described may also be used where the person has no fixed address or does not wish to have their residential or correspondence address recorded.</ehr:termdefinition.dp.description>
</rdf:Description>

<rdf:Description rdf:about="http://bki.skane.se/ikm/id/ikmopenehr:termdefinition/splash-adl2-tpl/openEHR-DEMOGRAPHIC-ADDRESS.address.v1.0.0/terminology/main/en/id1">
